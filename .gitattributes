# 自动检测文本文件的行尾符
* text=auto

# 明确标记所有源代码为文本文件，使用LF行尾符
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf

# Windows脚本使用CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.gguf binary
